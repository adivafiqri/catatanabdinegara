# Cloudflare Tunnel "can-server": tryout. & admin.catatanabdinegara.site → web lokal 127.0.0.1:3000.
# Kredensial & konfigurasi di ~/.cloudflared/ (izin 600). Lihat docs/runbook/web.md.
[Unit]
Description=Cloudflare Tunnel Catatan Abdi Negara
After=network-online.target can-web.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cloudflared --no-autoupdate --config %h/.cloudflared/can-server.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
