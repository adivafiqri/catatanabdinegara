# Cloudflare Tunnel: menghubungkan web lokal (127.0.0.1:3000) ke internet tanpa membuka port.
# Token disimpan di ~/.config/catatanabdinegara/tunnel.env (izin 600), BUKAN di .env utama,
# agar proses tunnel tidak memegang password database.
[Unit]
Description=Cloudflare Tunnel Catatan Abdi Negara
After=network-online.target can-web.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/catatanabdinegara/tunnel.env
ExecStart=%h/.local/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
