# Salin menjadi .env lalu isi. File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Setelah diisi: chmod 600 .env

# ---------- Bot Telegram ----------
# Token dari @BotFather (/newbot). Rahasia: jangan dikirim lewat chat ke siapa pun.
TELEGRAM_BOT_TOKEN=

# Database bot.
#   VPS tanpa Postgres: pglite:///home/dipsy/catatanabdinegara-data/bot   (folder di LUAR repo)
#   Supabase (nanti):   postgres://bot_rw:PASSWORD@HOST:6543/postgres
BOT_DATABASE_URL=pglite:///home/dipsy/catatanabdinegara-data/bot

# polling = cocok untuk VPS tanpa domain/HTTPS. webhook = butuh URL HTTPS publik.
BOT_MODE=polling

# ID grup yang dilayani (angka negatif, pisahkan koma). KOSONGKAN dulu untuk "mode persiapan":
# bot hanya menjawab /id di grup supaya ID grup bisa diketahui.
ALLOWED_CHAT_IDS=

# Opsional: grup khusus moderator untuk notifikasi & riwayat (ID angka).
MOD_CHAT_ID=

# Opsional: ID angka moderator selain admin grup (admin/pemilik grup otomatis moderator).
MODERATOR_IDS=

# Hanya untuk BOT_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=
PORT=8080
