# Salin menjadi .env lalu isi. File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Setelah diisi: chmod 600 .env

# ---------- Bot Telegram ----------
# Token dari @BotFather (/newbot). Rahasia: jangan dikirim lewat chat ke siapa pun.
TELEGRAM_BOT_TOKEN=

# Database bot (PostgreSQL lokal, role bot_rw — lihat docs/runbook/database.md).
#   Alternatif tanpa Postgres: pglite:///home/dipsy/catatanabdinegara-data/bot
BOT_DATABASE_URL=postgres://bot_rw:PASSWORD@127.0.0.1:5432/catatanabdinegara

# polling = cocok untuk VPS tanpa domain/HTTPS. webhook = butuh URL HTTPS publik.
BOT_MODE=polling

# ID grup yang dilayani (angka negatif, pisahkan koma). KOSONGKAN dulu untuk "mode persiapan":
# bot hanya menjawab /id di grup supaya ID grup bisa diketahui.
ALLOWED_CHAT_IDS=

# Opsional: grup khusus moderator untuk notifikasi & riwayat (ID angka).
MOD_CHAT_ID=

# Opsional: ID angka moderator selain admin grup (admin/pemilik grup otomatis moderator).
MODERATOR_IDS=

# Hanya untuk BOT_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=
PORT=8080

# ---------- Web (Milestone 2+) ----------
# PostgreSQL lokal, role can_web (pemilik tabel bank soal di schema public)
WEB_DATABASE_URL=postgres://can_web:PASSWORD@127.0.0.1:5432/catatanabdinegara

# ---------- Web: sesi login ----------
# Rahasia acak >= 32 karakter: openssl rand -hex 32
BETTER_AUTH_SECRET=
TRYOUT_ORIGIN=https://tryout.catatanabdinegara.site
ADMIN_ORIGIN=https://admin.catatanabdinegara.site
